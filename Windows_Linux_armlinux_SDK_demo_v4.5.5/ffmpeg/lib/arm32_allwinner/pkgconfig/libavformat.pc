prefix=./install/allwinner_arm32/
exec_prefix=${prefix}
libdir=./install/allwinner_arm32//lib
includedir=./install/allwinner_arm32//include

Name: libavformat
Description: FFmpeg container format library
Version: 58.20.100
Requires: 
Requires.private: libavcodec >= 58.35.100, libswresample >= 3.3.100, libavutil >= 56.22.100
Conflicts:
Libs: -L${libdir}  -lavformat 
Libs.private: -lm
Cflags: -I${includedir}
