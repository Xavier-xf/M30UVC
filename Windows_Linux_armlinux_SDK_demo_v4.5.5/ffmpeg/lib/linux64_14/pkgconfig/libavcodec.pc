prefix=./install/linux64
exec_prefix=${prefix}
libdir=./install/linux64/lib
includedir=./install/linux64/include

Name: libavcodec
Description: FFmpeg codec library
Version: 58.35.100
Requires: 
Requires.private: libswresample >= 3.3.100, libavutil >= 56.22.100
Conflicts:
Libs: -L${libdir}  -lavcodec 
Libs.private: -pthread -lm
Cflags: -I${includedir}
